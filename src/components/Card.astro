---

const borderColors = {
  "cyan": "border-cyan-500 dark:border-cyan-400",
  "gold": "border-jpmc-gold dark:border-jpmc-gold-400",
  "blue": "border-jpmc-blue dark:border-jpmc-blue-400",
  "gray": "border-jpmc-gray dark:border-jpmc-gray-400",
  "red": "border-jpmc-red dark:border-jpmc-red-400",
  "green": "border-jpmc-green dark:border-jpmc-green-400",
  "purple": "border-jpmc-purple dark:border-jpmc-purple-400",
  "orange": "border-jpmc-orange dark:border-jpmc-orange-400",
  "pink": "border-jpmc-pink dark:border-jpmc-pink-400",
  "brown": "border-jpmc-brown dark:border-jpmc-brown-400",
  "teal": "border-jpmc-teal dark:border-jpmc-teal-400",
  "indigo": "border-jpmc-indigo dark:border-jpmc-indigo-400",
  "violet": "border-jpmc-violet dark:border-jpmc-violet-400",
  "lime": "border-jpmc-lime dark:border-jpmc-lime-400",
} as const;

interface Props {
  title: string;
  description: string;
  link?: string;
  linkText?: string;
  borderColor?: keyof typeof borderColors;
  className?: string;
  badges?: Array<{ text: string; color: string; bgColor: string }>;
  date?: string;
  hoverColor?: string;
  external?: boolean;
}

const {
  title,
  description,
  link,
  linkText = title,
  borderColor = "cyan",
  className = "",
  badges = [],
  date,
  hoverColor = "cyan-600",
  external = false
} = Astro.props;

// Calculate datetime from date (assuming ET start of day)
function calculateDatetime(dateString: string): string {
  try {
    // Parse the date string and create a date object
    const date = new Date(dateString);
    
    // Set to Eastern Time start of day (00:00:00)
    const etDate = new Date(date.toLocaleString("en-US", { timeZone: "America/New_York" }));
    etDate.setHours(0, 0, 0, 0);
    
    // Return in ISO format
    return etDate.toISOString();
  } catch (error) {
    // If parsing fails, return the original string
    return dateString;
  }
}

---

<div
  class={`bg-white dark:bg-jpmc-gray-600 p-6 rounded-lg shadow-md border-l-4 ${borderColors[borderColor]} ${className}`}
>
  <h3 class="text-xl font-semibold text-jpmc-dark dark:text-jpmc-gray-100 mb-3">
    {link ? (
      <a
        href={link}
        class={`hover:text-${hoverColor} transition-colors`}
        target={external ? "_blank" : undefined}
        rel={external ? "noopener noreferrer" : undefined}
      >
        {linkText}
        {external && <span class="ml-1 text-sm">↗</span>}
      </a>
    ) : (
      title
    )}
  </h3>
  <p class="text-gray-600 dark:text-jpmc-gray-400 mb-4">
    {description}
  </p>
  
  {badges.length > 0 && (
    <div class="text-sm text-gray-500 dark:text-jpmc-gray-400 mb-2">
      {badges.map((badge) => (
        <span class={`${badge.bgColor} ${badge.color} px-2 py-1 rounded mr-2`}>
          {badge.text}
        </span>
      ))}
    </div>
  )}
  {date && (
    <time class="text-sm text-gray-400 dark:text-jpmc-gray-400" datetime={calculateDatetime(date)}>
      {date}
    </time>
  )}
</div>